(    RANDOM_STATE = 42) Tj
T*
(    N_SAMPLES = 1000) Tj
T*
(    TEST_SIZE = 0.20) Tj
T*
() Tj
T*
(    FEATURE_COLUMNS = ["GreenIndex", "Texture", "Moisture", "Height", "NDVI"]) Tj
T*
(    TARGET_COLUMN = "WeedPresent") Tj
T*
() Tj
T*
(    MODEL_PATH = Path\("weed_rf_model.pkl"\)) Tj
T*
