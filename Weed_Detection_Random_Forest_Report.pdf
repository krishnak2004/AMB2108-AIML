T*
() Tj
T*
(    def generate_synthetic_weed_dataset\() Tj
T*
(        n_samples: int = N_SAMPLES,) Tj
T*
(        random_state: int = RANDOM_STATE,) Tj
T*
(    \) -> pd.DataFrame:) Tj
T*
(        """Create a reproducible synthetic dataset with agriculturally named features.) Tj
T*
() Tj
T*
(        Class meanings:) Tj
T*
(        - 0: Crop) Tj
T*
(        - 1: Weed) Tj
T*
() Tj
T*
(        The feature distributions intentionally overlap so the task remains realistic) Tj
T*
(        instead of being perfectly separable.) Tj
T*
(        """) Tj
T*
() Tj
T*
(        rng = np.random.default_rng\(random_state\)) Tj
T*
() Tj
T*
(        # Rough field ratio: 60% crop, 40% weed.) Tj
T*
(        y = rng.choice\([0, 1], size=n_samples, p=[0.60, 0.40]\)) Tj
T*
() Tj
T*
(        green_index = np.where\() Tj
T*
(            y == 0,) Tj
T*
(            rng.normal\(loc=0.68, scale=0.11, size=n_samples\),) Tj
T*
(            rng.normal\(loc=0.40, scale=0.14, size=n_samples\),) Tj
T*
(        \)) Tj
T*
(        texture = np.where\() Tj
T*
(            y == 0,) Tj
T*
(            rng.normal\(loc=0.95, scale=0.28, size=n_samples\),) Tj
T*
(            rng.normal\(loc=1.50, scale=0.35, size=n_samples\),) Tj
T*
(        \)) Tj
T*
(        moisture = np.where\() Tj
T*
(            y == 0,) Tj
T*
(            rng.normal\(loc=0.58, scale=0.11, size=n_samples\),) Tj
T*
(            rng.normal\(loc=0.47, scale=0.14, size=n_samples\),) Tj
T*
(        \)) Tj
T*
(        height = np.where\() Tj
T*
(            y == 0,) Tj
T*
(            rng.normal\(loc=29.0, scale=5.0, size=n_samples\),) Tj
T*
(            rng.normal\(loc=18.5, scale=5.5, size=n_samples\),) Tj
T*
(        \)) Tj
T*
(        ndvi = np.where\() Tj
T*
(            y == 0,) Tj
T*
(            rng.normal\(loc=0.76, scale=0.10, size=n_samples\),) Tj
T*
(            rng.normal\(loc=0.32, scale=0.16, size=n_samples\),) Tj
T*
(        \)) Tj
T*
() Tj
T*
(        # Introduce mild correlations and realistic measurement noise.) Tj
T*
(        green_index = green_index + 0.10 * ndvi + rng.normal\(0, 0.02, n_samples\)) Tj
T*
(        moisture = moisture + 0.03 * green_index + rng.normal\(0, 0.02, n_samples\)) Tj
T*
(        height = height + 3.0 * ndvi + rng.normal\(0, 1.2, n_samples\)) Tj
T*
ET
